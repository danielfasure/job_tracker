
<div class="page">

    <%- include("partials/header.ejs") %>

    <div class="page-layout">

        <!-- Sidebar -->
        <%- include("./partials/navbar_extra.ejs") %>


        <!-- Settings Content -->
        <main class="container-fluid py-3 py-md-5 px-3 px-md-4 settings-container">

            <div class="row justify-content-center">

                <div class="col-12 ">

                    <div class="card shadow-sm border-0 rounded-3 bg-light">

                        <div class="card-body p-3 p-md-4 p-lg-5">

                            <!-- Header -->
                            <div class="text-center mb-4">

                                <i class="bi bi-gear-fill fs-1 text-secondary"></i>

                                <h1 class="fw-bold fs-3 text-dark mt-2 mb-1">
                                    User Settings
                                </h1>

                                <p class="text-muted mb-0">
                                    Manage your account details
                                </p>

                            </div>


                            <% if (user) { %>

                            <form action="/updatesettings" method="POST" id="settings_form">

                                <div class="d-flex flex-column gap-3">

                                    <!-- Password Setting -->
                                    <div class="card border rounded-3 bg-white">

                                        <div class="card-body p-3">

                                            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">

                                                <div class="d-flex align-items-start gap-3 flex-grow-1 min-w-0">

                                                    <div class="fs-4 text-secondary">
                                                        <i class="bi bi-lock-fill"></i>
                                                    </div>

                                                    <div class="flex-grow-1 min-w-0">

                                                        <h2 class="h6 fw-bold mb-1">
                                                            Password
                                                        </h2>

                                                        <p id="password_display" class="text-muted small mb-2">
                                                            Your password is hidden
                                                        </p>

                                                        <input
                                                            type="password"
                                                            name="Password"
                                                            id="password_input"
                                                            class="form-control form-control-sm hidden"
                                                            placeholder="Enter new password"
                                                            
                                                        >

                                                    </div>

                                                </div>


                                                <button
                                                    type="button"
                                                    class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                                    id="edit_password_button"
                                                    data-toggle="collapse"
                                                    data-target="#collapsepassword"
                                                    aria-expanded="false"
                                                    >

                                                    <i class="bi bi-pencil-square me-1"></i>
                                                    Edit

                                                </button>
                                                <div class="collapse" id ="collapsepassword">
                                                        <input class="form-control">
                                                </div>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Email Setting -->
                                    <div class="card border rounded-3 bg-white">

                                        <div class="card-body p-3">

                                            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">

                                                <div class="d-flex align-items-start gap-3 flex-grow-1 min-w-0">

                                                    <div class="fs-4 text-secondary">
                                                        <i class="bi bi-envelope-fill"></i>
                                                    </div>

                                                    <div class="flex-grow-1 min-w-0">

                                                        <h2 class="h6 fw-bold mb-1">
                                                            Email
                                                        </h2>

                                                        <p id="email_display" class="text-muted small mb-2 text-break">
                                                            <%= user.Email %>
                                                        </p>

                                                        <input
                                                            type="email"
                                                            name="Email"
                                                            id="email_input"
                                                            class="form-control collapseemail hidden"
                                                            value="<%= user.Email %>"
                                                           
                                                        >

                                                    </div>
                                                    

                                                </div>


                                                <button
                                                    type="button"
                                                    class="btn btn-outline-secondary btn-sm flex-shrink-0"
                                                    id="edit_email_button">

                                                    <i class="bi bi-pencil-square me-1"></i>
                                                    Edit

                                                </button>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Save Changes -->
                                    <div class="border-top pt-3 mt-2 text-center">

                                        <button
                                            type="submit"
                                            class="btn btn-secondary w-100 w-sm-auto px-4"
                                            id="submituser_button">

                                            <i class="bi bi-check-circle me-1"></i>
                                            Save Changes

                                        </button>

                                    </div>

                                </div>

                            </form>


                            <% } else { %>


                            <!-- No User -->
                            <div class="text-center py-4">

                                <i class="bi bi-person-x fs-1 text-secondary"></i>

                                <h2 class="h5 fw-bold mt-3">
                                    No user settings available
                                </h2>

                                <p class="text-muted mb-0">
                                    Your account settings will appear here once your account has been set up.
                                </p>

                            </div>


                            <% } %>

                        </div>

                    </div>

                </div>

            </div>
 <%- include("partials/footer.ejs") %>
        </main>
 
    </div>


    <!-- Modal -->
    <%- include("partials/modalApplicationadder.ejs") %>


    <!-- Footer -->
 

</div>
