
<!-- Application Statistics Header -->
<section class="application-summary card shadow-sm border-top border-bottom border-left  p-3 p-md-4 mb-4">

    <!-- Welcome -->
    <div class="application-summary-heading mb-4  text-center">

        <div class="application-summary-title">
            <i class="bi bi-bar-chart-fill"></i>

            <div>
                <h2 class="fw-bold mb-1">welcome</h2>

                <p class="text-muted mb-0">
                use to track your jobs with ease 
                </p>
            </div>
        </div>

    </div>

    <% if (stat) { %>

        <div class="application-summary-grid">

            <!-- Total Applications -->
            <div class="summary-stat">

                <div class="summary-icon">
                    <i class="bi bi-briefcase-fill"></i>
                </div>

                <div class="summary-info">
                    <span class="summary-label">Total Jobs Applied</span>

                    <span class="summary-value">
                        <%= stat.TotalNumberOfApplication %>
                    </span>
                </div>

            </div>

            <!-- Total Login Days -->
            <div class="summary-stat">

                <div class="summary-icon">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>

                <div class="summary-info">
                    <span class="summary-label">Total Login Days</span>

                    <span class="summary-value">
                        <%= stat.TotalLoginDays %>
                    </span>
                </div>

            </div>

            <!-- Login Streak -->
            <div class="summary-stat">

                <div class="summary-icon">
                    <i class="bi bi-fire"></i>
                </div>

                <div class="summary-info">
                    <span class="summary-label">Login Streak</span>

                    <span class="summary-value">
                        <%= stat.LoginStreak %>
                        <small>days</small>
                    </span>
                </div>

            </div>

        </div>

    <% } else { %>

        <div class="stats-empty text-center py-3">
            <i class="bi bi-emoji-smile"></i>

            <p class="mb-0 mt-2">
                Start tracking your applications to see your statistics.
            </p>
        </div>

    <% } %>

</section>


