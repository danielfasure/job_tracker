<div class="job_list border bg-light my-5 text-center mx-auto">

    <h1 class="fs-2 fw-bold my-2">
        <i class="bi bi-briefcase-fill"></i>
    </h1>

    <div class="text-center " id="viewApplication">

        <% if (Array.isArray(applications) && applications.length > 0) { %>

        <div class="applications-list">

            <% applications.forEach((application, index) => { %>

            <div class="application-card " data-application-id="<%= application.id %>" >

                <!-- Header -->
                <button
                    class="application-header"
                    type="button"
                    data-application="<%= application.id %>"
                >

                    <div class="application-main-info">

                        <div>
                            <span class="application-label">
                                Job Title
                            </span>

                            <h2 class="application-title">
                                <%= application.JobTitle %>
                            </h2>
                        </div>

                        <div>
                            <span class="application-label">
                                Company
                            </span>

                            <p class="application-company">
                                <i class="bi bi-building"></i>
                                <%= application.CompanyName %>
                            </p>
                        </div>

                    </div>

                    <i class="bi bi-chevron-down application-chevron "></i>

                </button>


                <!-- Expanded details -->
                <div
                    class="application-details"
                    data-details="<%= index %>"
                >

                    <div class="application-detail">

                        <span class="application-label">
                            <i class="bi bi-card-text"></i>
                            Description
                        </span>

                        <p>
                            <%= application.JobDescription %>
                        </p>

                    </div>


                    <div class="application-detail">

                        <span class="application-label">
                            <i class="bi bi-calendar3"></i>
                            Date Applied
                        </span>

                        <p>
                            <%= new Date(application.DateCreated).toLocaleDateString('en-GB') %>
                        </p>

                    </div>
                    <div class="applicationoptionsdiv hidden ">
                    <div class="editapplicationopener application-actions">
                            <input
                                type="hidden"
                                name="jobid"
                                value="<%= application.id %>"
                            >

                            <button
                                type="button"
                                class="btn btn-outline-warning editapplicationopenerbutton"  data-bs-toggle="modal"
                                    data-bs-target="#applicationeditModal"
                                     data-application-id="<%= application.id %>">
                            
                               
                            edit Job info ?
                            </button>

                  

                    </div>
                       <div class="editprogressopener application-actions">
                            <input
                                type="hidden"
                                name="jobid"
                                value="<%= application.id %>"
                            >

                            <button
                                type="button"
                                class="btn btn-outline-warning mx-auto editprogressopener" data-bs-toggle="modal"
                                    data-bs-target="#progressionModal"
                                     data-application-id="<%= application.id %>">
                            
                              
                           update progress?
                            </button>

                  

                    </div>

                    <!-- Delete -->
                    <div class="application-actions">

                        <form
                            action="/deletejob"
                            method="POST"
                        >

                            <input
                                type="hidden"
                                name="jobid"
                                value="<%= application.id %>"
                            >

                            <button
                                type="submit"
                                class="btn btn-outline-danger"
                            >
                                <i class="bi bi-trash3"></i>
                                 Application
                            </button>

                        </form>

                    </div>

                </div>

            </div>

           
             </div>
     
            <% }); %>


        <% } else { %>

            <p>No applications set.</p>

        <% } %>
        </div>
    
    </div>
<p><i class="bi bi-card-list" id ="viewApplicationbutton"></p></i>

</div>