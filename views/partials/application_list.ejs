<div class="job_list border bg-light my-5 text-center mx-auto" id="viewApplication">



  

        <% if (Array.isArray(applications) && applications.length > 0) { %>

        
            <% applications.forEach((application, index) => { %>

            <div class="application-card " data-application-id="<%= application.id %>" >
                    
                <!-- Header -->
                <button
                    class="application-header"
                    type="button"
                    data-application="<%= application.id %>"
                >

                    <div class="application-main-info">

                        <div>
                            <span class="application-label">
                                Job Title
                            </span>

                            <h2 class="application-title">
                                <%= application.JobTitle %>
                            </h2>
                        </div>

                        <div>
                            <span class="application-label">
                                Company
                            </span>

                            <p class="application-company">
                                <i class="bi bi-building"></i>
                                <%= application.CompanyName %>
                            </p>
                        </div>

                    </div>

                    <i class="bi bi-chevron-down application-chevron "></i>

                </button>


                <!-- Expanded details -->
                <div
                    class="application-details hidden"
                    data-details="<%= index %>"
                >

                    <div class="application-detail">

                        <span class="application-label">
                            <i class="bi bi-card-text"></i>
                            Description
                        </span>

                        <p>
                            <%= application.JobDescription %>
                        </p>

                    </div>

                    <div class="application-detail">

                        <span class="application-label">
                            <i class="bi bi-card-text"></i>
                           hour type
                        </span>

                        <p class="fs-1">
                            <%= application.hourtype %>
                        </p>

                    </div>
                       <div class="application-detail">

                        <span class="application-label">
                            <i class="bi bi-card-text"></i>
                      work place
                        </span>

                        <p class="fs-1">
                            <%= application.jobtype  %>
                        </p>

                    </div>
                   <% const extraapplication = extrajobs?.find(
    info => info.JobApplicationid === application.id
); %>
                    <div class="application-detail">

                        <span class="application-label">
                            <i class="bi bi-card-text"></i>
                            current stage type
                        </span>

                        <p class="fs-1">
                            <%= extraapplication.RoundType %>
                        </p>

                    </div>
                          <div class="application-detail">

                        <span class="application-label">
                            <i class="bi bi-card-text"></i>
                            ApplicationRound
                        </span>

                        <p class="fs-1">
                            <%= extraapplication.ApplicationRound %>
                        </p>

                    </div>
                     <div class="application-detail">

                        <span class="application-label">
                            <i class="bi bi-card-text"></i>
                        Status
                        </span>

                        <p class="fs-1" >
                            <%= extraapplication.Status %>
                        </p>

                    </div>



                    <div class="application-detail">

                        <span class="application-label">
                            <i class="bi bi-calendar3"></i>
                            Date Applied
                        </span>

                        <p class="fs-1">
                            <%= new Date(application.DateCreated).toLocaleDateString('en-GB') %>
                        </p>

                    </div>
                    </div>
                    <div class="applicationoptionsdiv hidden ">
                    <div class="editapplicationopener application-actions">
                            <input
                                type="hidden"
                                name="jobid"
                                value="<%= application.id %>"
                            >

                            <button
                                type="button"
                                class="btn btn-outline-secondary editapplicationopenerbutton btn-sm"  data-bs-toggle="modal"
                                    data-bs-target="#applicationeditModal"
                                     data-application-id="<%= application.id %>">
                            
                               
                            edit Job info ?
                            </button>

                  

                    </div>
                       <div class=" application-actions">
                            <input
                                type="hidden"
                                name="jobid"
                                value="<%= application.id %>"
                            >

                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm mx-auto editprogressopener" data-bs-toggle="modal"
                                    data-bs-target="#progressionModal"
                                     data-application-id="<%= application.id %>">
                            
                              
                           update progress?
                            </button>

                  

                    </div>

                    <!-- Delete -->
                    <div class="application-actions">

                       

                            <input
                                type="hidden"
                                name="jobid"
                                value="<%= application.id %>"
                            >

                            <button
                                type="button"
                                class="btn btn-outline-danger btn-sm"
                              data-bs-target="#deleteModal" data-bs-toggle="modal"
                                     data-application-id="<%= application.id %>">

                                <i class="bi bi-trash3"></i>
                                 Application
                            </button>

                    
                    </div>

                </div>
                

          

           
             </div>
     
            <% }); %>


        <% } else { %>

            <p>No applications set.</p>

        <% } %>
        </div>
    
    
    <div class="text-center mx-auto my-4 col-4 "id="add-job-buttonopenerid ">

            <button
                type="button"
                class="btn btn-secondary add-job-buttonopener mx-auto"
               
                data-bs-target="#applicationaddModal" data-bs-toggle="modal"
            >
                <i class="bi bi-plus-circle mx-auto"></i>
                Add Job
            </button>
</div>


</div>