
<div
    class="d-flex flex-wrap align-items-start  gap-3 border-top border-bottom border-left bg-light p-3 p-md-4 rounded-3 my-1 flex-grow-1"
    id="viewApplication"
>

    <% if (Array.isArray(applications) && applications.length > 0) { %>

        <% applications.forEach((application, index) => { %>

            <% const extraapplication =
                extrajobs?.find(info =>
                    info.JobApplicationid === application.id
                ) || {};
            %>

            <!-- Application Card -->
            <div class="card application-card shadow-sm flex-shrink-0">

                <!-- Clickable Header -->
                <div class="card-header bg-white p-0">

                    <button
                        class="btn w-100 text-start p-3 application-card-toggle"
                        type="button"
                        data-application="<%= application.id %>"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseExample<%= application.id %>"
                    
                        
                    >

                        <div class="d-flex justify-content-between align-items-start gap-2">

                            <div class="flex-grow-1 min-w-0">

                                <span class="text-uppercase text-muted fw-bold small d-block mb-1">
                                    Job Title
                                </span>

                                <h2 class="h5 text-dark fw-semibold mb-3 application-title">
                                    <%= application.JobTitle %>
                                </h2>

                                <span class="text-uppercase text-muted fw-bold small d-block mb-1">
                                    Company
                                </span>

                                <p class="text-secondary small mb-0 application-company">
                                    <i class="bi bi-building me-1"></i>
                                    <%= application.CompanyName %>
                                </p>

                            </div>

                            <i class="bi bi-chevron-down application-chevron mt-1"></i>

                        </div>

                    </button>

                </div>


                <!-- Collapsible Details: Hidden by Default -->
                <div
                    class="collapse"
                    id="collapseExample<%= application.id %>"
                >

                    <div class="card-body p-3">

                        <!-- Description -->
                        <div class="mb-3">

                            <span class="text-uppercase text-muted fw-bold small d-block mb-2">
                                <i class="bi bi-card-text me-1"></i>
                                Description
                            </span>

                            <p class="text-dark small mb-0 application-description">
                                <%= application.JobDescription || 'No description provided.' %>
                            </p>

                        </div>


                        <hr class="my-3">


                        <!-- Application Information -->
                        <div class="row g-3">

                            <!-- Hour Type -->
                            <div class="col-12 col-sm-6">

                                <span class="text-uppercase text-muted fw-bold small d-block mb-1">
                                    <i class="bi bi-clock me-1"></i>
                                    Hour Type
                                </span>

                                <p class="fw-semibold text-dark small mb-0">
                                    <%= application.hourtype || 'N/A' %>
                                </p>

                            </div>


                            <!-- Workplace -->
                            <div class="col-12 col-sm-6">

                                <span class="text-uppercase text-muted fw-bold small d-block mb-1">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    Workplace
                                </span>

                                <p class="fw-semibold text-dark small mb-0">
                                    <%= application.jobtype || 'N/A' %>
                                </p>

                            </div>


                            <!-- Current Stage -->
                            <div class="col-12 col-sm-6">

                                <span class="text-uppercase text-muted fw-bold small d-block mb-1">
                                    <i class="bi bi-diagram-3 me-1"></i>
                                    Current Stage
                                </span>

                                <p class="fw-semibold text-dark small mb-0">
                                    <%= extraapplication.RoundType || 'N/A' %>
                                </p>

                            </div>


                            <!-- Interview Round -->
                            <div class="col-12 col-sm-6">

                                <span class="text-uppercase text-muted fw-bold small d-block mb-1">
                                    <i class="bi bi-hash me-1"></i>
                                    Interview Round
                                </span>

                                <p class="fw-semibold text-dark small mb-0">
                                    <%= extraapplication.ApplicationRound || 'N/A' %>
                                </p>

                            </div>


                            <!-- Status -->
                            <div class="col-12 col-sm-6">

                                <span class="text-uppercase text-muted fw-bold small d-block mb-2">
                                    <i class="bi bi-flag me-1"></i>
                                    Status
                                </span>

                                <span class="badge bg-secondary">
                                    <%= extraapplication.Status || 'Pending' %>
                                </span>

                            </div>


                            <!-- Date Applied -->
                            <div class="col-12 col-sm-6">

                                <span class="text-uppercase text-muted fw-bold small d-block mb-1">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    Date Applied
                                </span>

                                <p class="fw-semibold text-dark small mb-0">
                                    <%= new Date(application.DateCreated).toLocaleDateString('en-GB') %>
                                </p>

                            </div>

                        </div>


                        <!-- Action Buttons -->
                        <div class="applicationoptionsdiv border-top pt-3 mt-3 d-flex flex-wrap gap-2">

                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#applicationeditModal"
                                data-application-id="<%= application.id %>"
                            >
                                <i class="bi bi-pencil me-1"></i>
                                Edit Job
                            </button>


                            <button
                                type="button"
                                class="btn btn-outline-primary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#progressionModal"
                                data-application-id="<%= application.id %>"
                            >
                                <i class="bi bi-arrow-repeat me-1"></i>
                                Update Progress
                            </button>


                            <button
                                type="button"
                                class="btn btn-outline-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-application-id="<%= application.id %>"
                            >
                                <i class="bi bi-trash3 me-1"></i>
                                Delete
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        <% }); %>

    <% } else { %>

        <div class="p-5 text-muted text-center">

            <i class="bi bi-inbox fs-1 d-block mb-2"></i>

            <p class="mb-0">No applications set yet.</p>

        </div>

    <% } %>


    <!-- Add Job Button -->
    <div class="w-100 text-center my-3" id="add-job-buttonopenerid">

        <button
            type="button"
            class="btn btn-secondary add-job-buttonopener shadow-sm px-4"
            data-bs-target="#applicationaddModal"
            data-bs-toggle="modal"
        >
            <i class="bi bi-plus-circle me-1"></i>
            Add Job
        </button>

    </div>
<%- include("footer.ejs") %>
</div>



