 <div class="job_extra_adder border br-3 bg-light my-5 text-center mx-auto" id="add_job">

    <div class="add-job-header text-center">
        <i class="bi bi-briefcase-plus-fill add-job-icon"></i>

        <h1 class="fs-2 fw-bold">
            Application progression 
        </h1>

        <p class="text-muted">
            change the progression status of your application 
        </p>
    </div>


    <form
        class="add-job-form"
        action="/creatextrajob"
        method="POST"
    >

        <!-- Company -->
        <div class="form-group">

                <i class="bi bi-building"></i>
                Company Name
         

            <p
                class=""
                id="CompanyNameid"
                name="CompanyName"
            >
        
        </p>

        </div>


        <!-- Job title -->
        <div class="form-group">

           
                <i class="bi bi-briefcase"></i>
                Job Title
           

            <p
              
                class=""
                id="JobTitleid"
                name="JobTitle"
            ></p>

        </div>


        <!-- Date -->
        <div class="form-group">

            <label
                class="form-label"
                for="ApplicationRoundid"
            >
                <i class="bi bi-calendar3"></i>
                Application round
            </label>

            <input
                type="number"
                id="ApplicationRoundid"
                name="ApplicationRound"
                class="form-control"
              placeholder="leave blank for stage 1"
            >

        </div>


        <!-- Description -->
        <div class="form-group">

            <label
                class="form-label"
                for="Status"
            >
                <i class="bi bi-card-text"></i>
                Status
            </label>

            <input 
                id="Statusid"
                name="Status"
                class="form-control"
               
                placeholder="will be left as pending "
            >

        </div>


        <!-- Submit -->
        <div class="text-center mx-auto my-4">

            <button
                type="submit"
                class="btn btn-primary mx-auto "
            >
                <i class="bi bi-plus-circle"></i>
               
            </button>

        </div>

    </form>

</div>