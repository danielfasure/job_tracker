<div id="applicationaddModal" class="modal fade" tabindex="-1" aria-labelledby="applicationaddModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content shadow-sm position-relative">

      <!-- Modal Header -->
      <div class="modal-header bg-light">
        <div class="d-flex align-items-center gap-2 mx-auto">
          <i class="bi bi-briefcase-plus-fill text-primary fs-4"></i>
          <h5 class="modal-title fw-bold text-dark my-0" id="applicationaddModalLabel">
            Add Job Application
          </h5>
        </div>
        <button id="closeapplicationModal" type="button" class="btn-close m-0" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body p-4">
        <p class="text-muted text-center mb-4 small">
          Add a new job application to your tracker
        </p>

        <form id="add_job" class="add-job-form" action="/createjob" method="POST">

          <!-- Row 1: Company Name & Job Title -->
          <div class="row g-3 mb-3">
            <div class="col-md-6 text-start">
              <label class="form-label fw-semibold text-muted small mb-1" for="CompanyNameid">
                <i class="bi bi-building me-1"></i>Company Name
              </label>
              <input
                type="text"
                class="form-control"
                id="CompanyNameid"
                name="CompanyName"
                placeholder="e.g. Microsoft"
                required
              >
            </div>

            <div class="col-md-6 text-start">
              <label class="form-label fw-semibold text-muted small mb-1" for="JobTitleid">
                <i class="bi bi-briefcase me-1"></i>Job Title
              </label>
              <input
                type="text"
                class="form-control"
                id="JobTitleid"
                name="JobTitle"
                placeholder="e.g. Junior Software Developer"
                required
              >
            </div>
          </div>

          <!-- Row 2: Date, Hour Type, Work Location -->
          <div class="row g-3 mb-3">
            <div class="col-md-4 text-start">
              <label class="form-label fw-semibold text-muted small mb-1" for="companydateappliedid">
                <i class="bi bi-calendar3 me-1"></i>Date Applied
              </label>
              <input
                type="date"
                id="companydateappliedid"
                name="DateCreated"
                class="form-control"
                required
              >
            </div>

            <div class="col-md-4 text-start">
              <label class="form-label fw-semibold text-muted small mb-1" for="hourtypeid">
                <i class="bi bi-clock me-1"></i>Hour Type
              </label>
              <select id="hourtypeid" class="form-select" name="hourtype" required>
                <option value="" selected disabled>Select type...</option>
                <option value="part time">Part Time</option>
                <option value="full time">Full Time</option>
              </select>
            </div>

            <div class="col-md-4 text-start">
              <label class="form-label fw-semibold text-muted small mb-1" for="jobtypeid">
                <i class="bi bi-geo-alt me-1"></i>Work Location
              </label>
              <select id="jobtypeid" class="form-select" name="jobtype" required>
                <option value="" selected disabled>Select location...</option>
                <option value="onsite">Onsite</option>
                <option value="work from home">Work from Home</option>
                <option value="hybrid">Hybrid</option>
              </select>
            </div>
          </div>

          <!-- Description -->
          <div class="mb-4 text-start">
            <label class="form-label fw-semibold text-muted small mb-1" for="companydescription">
              <i class="bi bi-card-text me-1"></i>Job Description
            </label>
            <textarea
              id="companydescription"
              name="JobDescription"
              class="form-control"
              rows="4"
              placeholder="Add key responsibilities, requirements, or notes..."
            ></textarea>
          </div>

          <!-- Modal Footer / Actions -->
          <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary btn-sm px-4">
              <i class="bi bi-plus-circle me-1"></i>Add Application
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>