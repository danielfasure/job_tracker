<div id="applicationeditModal" class="modal fade" tabindex="-1" aria-labelledby="applicationeditModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow-sm position-relative">

      <!-- Modal Header -->
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold text-dark mx-auto" id="applicationeditModalLabel">
          <i class="bi bi-pencil-square me-2"></i>Edit Application
        </h5>
        <!-- Standard Bootstrap modal close button -->
        <button id="closeapplicationModal" type="button" class="btn-close m-0" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body p-4">
        <form id="applicationForm" action="/editjobinfo" method="post">

        <!-- Example inside your modal form -->
<input type="hidden" name="Applicationnumber" id="editApplicationId">

          <div class="mb-3 text-start">
            <label for="CompanyNameId" class="form-label fw-semibold text-muted small mb-1">
              Company Name
            </label>
            <input id="CompanyNameId" type="text" class="form-control" name="CompanyName" placeholder="e.g. Acme Corp">
          </div>

          <div class="mb-3 text-start">
            <label for="JobTitleId" class="form-label fw-semibold text-muted small mb-1">
              Job Title
            </label>
            <input id="JobTitleId" type="text" class="form-control" name="JobTitle" placeholder="e.g. Software Engineer">
          </div>

          <div class="mb-3 text-start">
            <label for="Date" class="form-label fw-semibold text-muted small mb-1">
              <i class="bi bi-calendar3 me-1"></i>Date Submitted
            </label>
            <input id="Date" type="date" class="form-control" name="DateCreated">
          </div>

          <div class="mb-3 text-start">
            <label for="JobDescriptionId" class="form-label fw-semibold text-muted small mb-1">
              Job Description
            </label>
            <textarea id="JobDescriptionId" name="JobDescription" class="form-control" rows="3" placeholder="Enter brief description..."></textarea>
          </div>

          <div class="mb-3 text-start">
            <label for="jobtypeid" class="form-label fw-semibold text-muted small mb-1">
              <i class="bi bi-building me-1"></i>Job Type
            </label>
            <select id="jobtypeid" class="form-select" name="jobtype">
              <option value="" selected disabled>Select location type...</option>
              <option value="onsite">Onsite</option>
              <option value="work from home">Work from Home</option>
              <option value="hybrid">Hybrid</option>
            </select>
          </div>

          <div class="mb-4 text-start">
            <label for="hourtypeid" class="form-label fw-semibold text-muted small mb-1">
              <i class="bi bi-clock me-1"></i>Hour Type
            </label>
            <select id="hourtypeid" class="form-select" name="hourtype">
              <option value="" selected disabled>Select schedule...</option>
              <option value="part time">Part Time</option>
              <option value="full time">Full Time</option>
            </select>
          </div>

          <!-- Actions Footer / Submit Button -->
          <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">
              Cancel
            </button>
            <button type="submit" class="btn btn-outline-success btn-sm px-4">
              <i class="bi bi-check-lg me-1"></i>Save
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>