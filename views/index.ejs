<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel ="stylesheet" type="text/css" href="index.css">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body class="bg-dark">
    <h1 class="header fs-5 col-12 text-center bg-light"> Job tracker for you </h1>
<div class="container"> 
     
    
    <div class=" login_portal bg-light border mt-5">


  
    
<div class=" mx-5  text-center login_div bg-light   "  >
 <h1 class="text-center fw-bold fs-4  text-center "> Login  page  </h1>
<form class="  row  my-2  mx-auto" action="/submit" method="POST" >
 
        <div class=" form-group  col-lg-6 col-12">
        <label for ="Username" class="form-label"> Username </label>

        <input class="form-control  " type="text" id="Username" name="username">
        </div>
          <div class=" form-group col-lg-6 col-12">
        <label for ="Passwordlogin" class="form-label"> Password </label>

        <input class="form-control " type="password" id="Passwordlogin" name="password">
        </div>
         <div class="col-12 mt-5 m-auto text-center">
 <input type="submit" class="btn btn-primary" > 

</div>
</form>  
<button class=" btn m-auto mt-5 text-center col-lg-3 change_register_button">Change to Register Page   </button>

</div>
<div class="mx-auto  register_div my-5 bg-light text-center hidden ">
<h1 class="fs-4 fw-bold  mb-5"> Register page </h1>
<form class="  row my-5  mx-5" action="/register" method="POST">
     <div class=" form-group col-sm-12 col-lg-6 ">
        <label for ="usernameregister" class="form-label col-2"> username </label>
        <input class=" col-2 form-control my-2" id ="usernameregister" name="username">

    </div>
     <div class=" form-group col-sm-12 col-lg-6 ">
        <label for ="passwordregister" class="form-label"> password </label>
        <input class="form-control my-2" id ="passwordregister" name="password"> 

    </div>
    <div class=" form-group col-sm-12 col-lg-6 my-5">
        <label for ="passwordregister2" class="form-label"> password again  </label>
        <input class="form-control my-2" id = "passwordregister2" name="password2">

    </div>
      <div class=" form-group col-sm-12 col-lg-6 my-5 ">
        <label for ="email" class="form-label"> email  </label>
        <input class="form-control my-2" id ="email">

    </div>
    <div class="col-12 mt-5 m-auto text-center">
  <input class="m-auto btn btn-primary " type="submit" > 
</div>

</form>
<button class="btn mt-5 change_login_button">  Change to Login Page </button>
</div>

</div>
<div class="job_tracker_portal border bg-light   my-5 text-center">
<h1 class="fs-2 fw-bold ">Job Adder  </h1>
<form class="  row g-5 my-2 mx-2">

<div class=" form-group col-sm-12 col-lg-4">
    
    <label class="form-label" for ="CompanyName">company name </label>
    <input type = "text" class="form-control" id ="CompanyName" name = "CompanyName">
</div>
<div class=" form-group col-lg-4">
    <label class="form-label" for ="JobTitle">Job title  </label>
    <input type="text" id="JobTitle" class="form-control" name="JobTitle">

</div>
<div class="col-sm-12 col-lg-4 ">
    <label class="form-label" for ="JobDesc">Date when you applied </label>
    <input type="date" id="JobDesc" name="JobDesc" class="form-control">
</div>
<div class="col-12 ">
    <label for ="JobDesc">job description </label>
    <input type="text" id="JobDesc" name="JobDesc" class="form-control h-100 ">
</div>
<div class="col-12 mt-5 m-auto text-center">
  <button class="m-auto btn btn-primary "> add to tracker  </button>

</div>




</form>

</div>


<div class="my-5   border bg-light application_tracker ">
     <h1 class="text-center fw-bold fs-2 mb-5"> Application Tracker  </h1>
    <div class=" row mx-5 my-5">
        <div class=" card-group col-lg-4  ">

 <p class="fs-5"> Jobs applied for </p>
        </div>
         <div class="col-lg-4 col-sm-12">

    <p class="fs-5"> Interviews secured</p>
        </div>
         <div class="col-lg-4 col-sm-12">
  <p class="fs-5"> Assigments set </p>

        </div>
         <div class="mt-5 col-lg-4 col-sm-12">
<p class="fs-5"> Date since last application </p>

        </div>


    </div>
  
 
  
    

</div>

</div>
<script src="index.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
