
<div class="page">

    <%- include("partials/header.ejs") %>

    <!-- Main layout -->
    <div class="page-layout">

        <!-- Sidebar -->
        <%- include("./partials/navbar_extra.ejs") %>

        <!-- Statistics content -->
        <main class="container-fluid py-3 py-md-5 px-3 px-md-4 stats-container">

            <div class="row justify-content-center">

                <div class="col-12 col-xl-10">

                    <div class="application-tracker-card card shadow-sm border-0 rounded-3 bg-light p-3 p-md-4 mx-auto">

                        <!-- Header -->
                        <div class="tracker-header text-center mb-4">

                            <i class="bi bi-bar-chart-fill tracker-icon"></i>

                            <h1 class="fw-bold fs-2 mt-2">
                                Application Tracker
                            </h1>

                            <p class="text-muted mb-0">
                                Overview of your job applications
                            </p>

                        </div>

                        <% if (stat) { %>

                            <!-- Statistics grid -->
                            <div class="stats-grid">

                                <!-- Total Applications -->
                                <div class="stat-card">

                                    <div class="stat-icon">
                                        <i class="bi bi-briefcase-fill"></i>
                                    </div>

                                    <div class="stat-info">
                                        <span class="stat-label">
                                            Total Jobs Applied
                                        </span>

                                        <span class="stat-value">
                                            <%= stat.TotalNumberOfApplication %>
                                        </span>
                                    </div>

                                </div>

                                <!-- Active Interviews -->
                                <div class="stat-card">

                                    <div class="stat-icon">
                                        <i class="bi bi-chat-left-text-fill"></i>
                                    </div>

                                    <div class="stat-info">
                                        <span class="stat-label">
                                            Active Interviews
                                        </span>

                                        <span class="stat-value">
                                            <%= stat.NumberOfInterviewsActive %>
                                        </span>
                                    </div>

                                </div>

                                <!-- Login Days -->
                                <div class="stat-card">

                                    <div class="stat-icon">
                                        <i class="bi bi-person-circle"></i>
                                    </div>

                                    <div class="stat-info">
                                        <span class="stat-label">
                                            Total Login Days
                                        </span>

                                        <span class="stat-value">
                                            <%= stat.TotalLoginDays %>
                                        </span>
                                    </div>

                                </div>

                                <!-- First Login -->
                                <div class="stat-card">

                                    <div class="stat-icon">
                                        <i class="bi bi-calendar-week"></i>
                                    </div>

                                    <div class="stat-info">
                                        <span class="stat-label">
                                            First Login
                                        </span>

                                        <span class="stat-value stat-date">
                                            <%= new Date(stat.FirstLoginDate).toLocaleDateString("en-GB") %>
                                        </span>
                                    </div>

                                </div>

                                <!-- Login Streak -->
                                <div class="stat-card">

                                    <div class="stat-icon">
                                        <i class="bi bi-fire"></i>
                                    </div>

                                    <div class="stat-info">
                                        <span class="stat-label">
                                            Login Streak
                                        </span>

                                        <span class="stat-value">
                                            <%= stat.LoginStreak %>
                                        </span>
                                    </div>

                                </div>

                            </div>

                        <% } else { %>

                            <!-- No statistics -->
                            <div class="stats-empty text-center py-4">

                                <i class="bi bi-emoji-tear"></i>

                                <h2 class="h4 fw-bold mt-3">
                                    No Statistics Yet
                                </h2>

                                <p class="text-muted mb-0">
                                    Your statistics will appear here once you start using the application.
                                </p>

                            </div>

                        <% } %>

                    </div>

                </div>

            </div>
    <%- include("partials/footer.ejs") %>
        </main>

    </div>

    <!-- Application modal -->
    <%- include("partials/modalApplicationadder.ejs") %>

    <!-- Footer -->
 

</div>

