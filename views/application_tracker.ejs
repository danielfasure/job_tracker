<%- include("partials/header.ejs") %>
<%- include("partials/navbar.ejs") %>
<div class="container">
 

    <div class="my-2  mx-auto border bg-light application_tracker col-4 ">
     <h1 class="text-center fw-bold fs-2 mb-3"> Application Tracker  </h1>
       <% if (stat) { %>
    <div class=" row mb-5 g-2 mx-auto">
        <div class=" col-lg-5 col-sm-12 ms-auto">
<p class="fs-5"> first login date<br> <%= new Date(stat.FirstLoginDate).toLocaleDateString("en-GB") %> </p>

        </div>
        <div class=" col-lg-5 col-sm-12 mx-auto">
<p class="fs-5 text-center"> login streak<br> <%=stat.LoginStreak %> </p>

        </div>


    </div>
    

<%   }else {  %>
    <div class="col-5 mx-auto card">
        <h1> currently you have no stats set once you use the application that should change </h1>
     


    </div>

   



    <% } %>
    </div>

    <div class="job_tracker_portal border bg-light col-8  my-5 text-center mx-auto" id ="add_job">
<h1 class="fs-2 fw-bold my-2">Job Adder  </h1>
<form class="  row g-5 my-auto mx-auto" action="/createjob" method="POST">

<div class=" form-group col-sm-12 col-lg-5">
    
    <label class="form-label" for ="CompanyNameid">company name </label>
    <input type = "text" class="form-control" id ="CompanyNameid" name = "CompanyName">
</div>
<div class=" form-group col-lg-5 ms-auto">
    <label class="form-label" for ="JobTitleid">Job title  </label>
    <input type="text" id="JobTitleid" class="form-control" name="JobTitle">

</div>
<div class="col-sm-12 col-lg-12 ">
    <label class="form-label " for ="companydateappliedid">Application Sent Date  </label>
    <input type="date" id ="companydateappliedid" name="DateCreated" class="form-control col-4">
</div>
<div class="col-12 ">
    <label for ="companydescription">job description </label>
    <input type="text" id="companydescription" name="JobDescription" class="form-control h-100 ">
</div>
<div class="col-12 mt-5 m-auto text-center">
  
  <button class="m-auto btn btn-primary "type="submit"> add to tracker  </button>

</div>
</form>

    

    </div>

  <div class="job_list border bg-light col-8  my-5 text-center mx-auto">
    
<h1 class="fs-2 fw-bold my-2">Job List  </h1>
<div class="text-center my-5  "id="viewApplication">
   <% if (Array.isArray(applications) && applications.length > 0) { %>

    <% applications.forEach(application => { %>

        <div class="row mx-5 my-5">

            <div class="col-lg-6 col-sm-12">
                <p class="fs-5">
                <h1 class="fs-4">Title </h1><br>   <%= application.JobTitle %>
                </p>
            </div>

            <div class="col-lg-6 col-sm-12">
                <p class="fs-5">
                  <h1 class="fs-4"> Description </h1><br> <%= application.JobDescription %>
                </p>
            </div>

            <div class="col-lg-6 col-sm-12">
                <p class="fs-5">
                <h1 class="fs-4"> Date Applied </h1>   <br> <%= new Date(application.DateCreated).toLocaleDateString('en-GB') %>
                </p>
            </div>

            <div class="col-lg-6 col-sm-12">
                <p class="fs-5">
                <h1 class="fs-4"> Company Name </h1>   <br> <%= application.CompanyName %>
                </p>
            </div>

        </div>

    <% }); %>

<% } else { %>

    <p>No applications set.</p>

<% } %>
</div>

  </div>

  <div class=" text-center my-5">
    <button class="btn btn-success mx-auto text-center" id ="viewApplicationbutton">toggle applications</button>
</div>


   

   
  

   <form action="/logout" method="POST"  class="mx-auto text-center">
    <button type="submit" class="btn btn-danger mx-auto">
        Logout
    </button>
</form>
    

<%- include("partials/footer.ejs") %>
