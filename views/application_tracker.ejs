<%- include("partials/header.ejs") %>
<%- include("partials/navbar.ejs") %>
<div class="container">
 
<div class="top-stats-card my-3 mx-auto" id ="top_stats">

    <div class="top-stats-header text-center">

        <i class="bi bi-activity"></i>

        <h1>
            Application Tracker
        </h1>

    </div>


    <% if (stat) { %>

    <div class="top-stats-grid">

        <!-- Login Days -->
        <div class="top-stat">

            <div class="top-stat-icon">
                <i class="bi bi-person-check-fill"></i>
            </div>

            <div>
                <span class="top-stat-label">
                    Login Days
                </span>

                <span class="top-stat-value">
                    <%= stat.TotalLoginDays %>
                </span>
            </div>

        </div>


        <!-- Login Streak -->
        <div class="top-stat">

            <div class="top-stat-icon">
                <i class="bi bi-fire"></i>
            </div>

            <div>
                <span class="top-stat-label">
                    Login Streak
                </span>

                <span class="top-stat-value">
                    <%= stat.LoginStreak %>
                </span>
            </div>

        </div>

    </div>


    <% } else { %>

    <div class="top-stats-empty text-center">

        <i class="bi bi-emoji-tear"></i>

        <p>
            No statistics available yet.
        </p>

    </div>

    <% } %>

</div>
 

 <%- include("partials/application_list.ejs") %>
<%- include("partials/editApplicationprogress.ejs") %>
<%-include("partials/editApplicationinfo.ejs") %>
<%-include("partials/modalApplicationadder.ejs") %>
 <%-include("partials/confirm_deletejob.ejs") %>



  </div>

 


   

   
  


    

<%- include("partials/footer.ejs") %>
